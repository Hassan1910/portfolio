# Optional. Leave unset for a static site: the contact form opens the visitor's email app.
# Set this only when the Express contact API (npm run server) is deployed and reachable
# from the browser. Example for local dev:
# VITE_CONTACT_ENDPOINT=http://localhost:3001/api/send-email
VITE_CONTACT_ENDPOINT=

# Used by server.js only. Never commit a real key.
RESEND_API_KEY=
# Inbox that should receive contact mail. Resend's onboarding sender can only
# deliver to the address on the Resend account until a domain is verified.
CONTACT_TO=adanhassan1910@gmail.com
CONTACT_FROM=Portfolio Contact <onboarding@resend.dev>
PORT=3001
# CORS_ORIGIN=https://www.ahassan.software
